    \uC791\uC5C5\uAE30\uC785\uB2C8\uB2E4. \r\n\r\n\uBC29\uCCAD \uCC98\uB9AC \uBBF8\uBE44\uB85C
    \uC628\uBAB8\uC5D0 \uC2EC\uAC01\uD55C \uB179\uC774 \uC2AC\uC5B4\uBC84\uB9AC\uB294
    \uB2E8\uC810\uC774 \uC788\uC9C0\uB9CC, \uC131\uB2A5\uC5D0\uB294 \uC804\uD600
    \uC9C0\uC7A5\uC774 \uC5C6\uC2B5\uB2C8\uB2E4.\n \r\n\uC628\uAC16 \uC9C4\uD759\uD0D5\uC744
    \uB4B9\uAD74\uBA70 \uAE30\uCCB4 \uC804\uCCB4\uC5D0 \uB179\uC774 \uC2AC\uC5B4\uBC84\uB838\uC9C0\uB9CC,
    \uADF8 \uD6C8\uC7A5 \uAC19\uC740 \uBD80\uC2DD \uC790\uAD6D\uB4E4\uC740 '\uC2A4\uD06C\uB7A9'\uC774
    \uC5BC\uB9C8\uB098 \uB9CE\uC740 \uC704\uAE30\uB97C \uB118\uACA8\uC654\uB294\uC9C0
    \uBCF4\uC5EC\uC90D\uB2C8\uB2E4."
